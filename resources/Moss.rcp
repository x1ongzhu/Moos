#include "ids.h"
APPLICATIONICONNAME ID 1000 "Moss"
VERSION 1 "0.1.0"
MENU ID MENU_MAIN
BEGIN
 PULLDOWN "Chat"
 BEGIN
  MENUITEM "API settings" MENU_SETTINGS "S"
  MENUITEM "Test API connection" MENU_TEST
  MENUITEM "Retry last question" MENU_RETRY "R"
  MENUITEM "Rename chat" MENU_RENAME
  MENUITEM "Delete chat" MENU_DELETE
  MENUITEM "About Moss" MENU_ABOUT
 END
 PULLDOWN "Edit"
 BEGIN
  MENUITEM "Copy" MENU_COPY "C"
  MENUITEM "Paste" MENU_PASTE "P"
  MENUITEM "Select all" MENU_SELECT "A"
 END
END
FORM ID FORM_CHAT AT (0 0 160 160) NOFRAME USABLE MENUID MENU_MAIN
BEGIN
 TITLE "Moss"
 FIELD ID FIELD_REPLY AT (3 16 145 76) MULTIPLELINES NONEDITABLE MAXCHARS 4350
 SCROLLBAR ID SCROLL_REPLY AT (150 16 7 76)
 BUTTON "Prev" ID BUTTON_PREV AT (3 94 31 12)
 BUTTON "Next" ID BUTTON_NEXT AT (37 94 31 12)
 LABEL "Ready" ID 1010 AT (74 95)
 FIELD ID FIELD_INPUT AT (3 109 153 31) MULTIPLELINES UNDERLINED MAXCHARS 1024
 BUTTON "Send" ID BUTTON_SEND AT (3 144 45 13)
 BUTTON "Chats" ID BUTTON_CHATS AT (54 144 45 13)
 BUTTON "New" ID BUTTON_NEW AT (105 144 49 13)
END
FORM ID FORM_SETTINGS AT (0 0 160 160) NOFRAME USABLE MENUID MENU_MAIN
BEGIN
 TITLE "API settings"
 LABEL "Relay URL (include /v1)" ID 1110 AT (3 16)
 FIELD ID FIELD_URL AT (3 27 153 22) MULTIPLELINES UNDERLINED MAXCHARS 192
 LABEL "Model ID" ID 1111 AT (3 51)
 FIELD ID FIELD_MODEL AT (3 62 153 12) UNDERLINED MAXCHARS 63
 LABEL "Relay key (blank: keep)" ID 1112 AT (3 78)
 FIELD ID FIELD_KEY AT (3 89 153 12) UNDERLINED MAXCHARS 191
 CHECKBOX "Save key on device" ID CHECK_KEY AT (3 106 125 12)
 BUTTON "Clear key" ID BUTTON_CLEAR_KEY AT (3 123 56 12)
 BUTTON "Save" ID BUTTON_SAVE AT (3 143 60 13)
 BUTTON "Cancel" ID BUTTON_CANCEL AT (92 143 62 13)
END
FORM ID FORM_LIST AT (0 0 160 160) NOFRAME USABLE
BEGIN
 TITLE "Conversations"
 LIST ID LIST_CHATS AT (3 18 153 112) USABLE VISIBLEITEMS 9
 BUTTON "Open" ID BUTTON_OPEN AT (3 143 46 13)
 BUTTON "New" ID BUTTON_NEW AT (55 143 46 13)
 BUTTON "Back" ID BUTTON_BACK AT (107 143 46 13)
END
FORM ID FORM_RENAME AT (2 32 156 90) MODAL SAVEBEHIND USABLE
BEGIN
 TITLE "Rename chat"
 FIELD ID FIELD_TITLE AT (5 25 145 15) UNDERLINED MAXCHARS 39
 BUTTON "Save" ID BUTTON_SAVE AT (5 62 60 13)
 BUTTON "Cancel" ID BUTTON_CANCEL AT (87 62 60 13)
END
ALERT ID ALERT_INFO INFORMATION
BEGIN
 TITLE "Moss"
 MESSAGE "^1"
 BUTTONS "OK"
END
ALERT ID ALERT_DELETE CONFIRMATION
BEGIN
 TITLE "Delete chat?"
 MESSAGE "Remove this conversation and all its messages?"
 BUTTONS "Delete" "Cancel"
END
ALERT ID ALERT_ROM ERROR
BEGIN
 TITLE "Moss"
 MESSAGE "Palm OS 3.1 or newer is required."
 BUTTONS "OK"
END
